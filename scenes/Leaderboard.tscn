[gd_scene format=3 uid="uid://c8leaderboardpup"]

[ext_resource type="Script" path="res://scripts/leaderboard.gd" id="1_lb"]

[node name="Leaderboard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lb")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.5, 0.68, 0.92, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(420, 460)

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Local Leaderboard"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Saved on this device only"
horizontal_alignment = 1

[node name="BestsLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Your bests"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
size_flags_vertical = 3

[node name="EntriesBox" type="VBoxContainer" parent="Center/Panel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="EmptyLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "No saved runs yet — use Save Progress in-game!"
horizontal_alignment = 1
autowrap_mode = 3

[node name="BackBtn" type="Button" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Back to Menu"

[connection signal="pressed" from="Center/Panel/VBox/BackBtn" to="." method="_on_back_pressed"]
